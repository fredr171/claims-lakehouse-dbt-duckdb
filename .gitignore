# ---------------------------------------------------------------
# Secrets & credentials -- NEVER commit (see CLAUDE.md > Security)
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.env

# AWS credentials / config if ever copied into the repo
.aws/
credentials
*credentials*
*_accessKeys.csv
*accessKeys*.csv
*_credentials.csv

# Keys and certificates
*.pem
*.key
*.p12
*.pfx

# ---------------------------------------------------------------
# Local data -- source zips, extracted CSVs, Parquet output
# ---------------------------------------------------------------
data/
test_files/
*.zip
*.parquet

# DuckDB databases
*.duckdb
*.duckdb.wal
*.db

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
build/
transform_runs/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------
# dbt
# ---------------------------------------------------------------
target/
# Local marts Parquet (dbt/profiles.yml dev external_root); the folder itself is kept.
marts_local/*
!marts_local/.gitkeep
dbt_packages/
logs/
profiles.yml
# The project profile holds no secrets (AWS credential chain), so it is committed.
!dbt/profiles.yml

# ---------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
cdk.out/
tfplan
*.tfplan
crash.log
# (.terraform.lock.hcl IS committed: it pins provider versions)

# ---------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# dbt per-machine anonymous user id
.user.yml
