# Copy to .env (gitignored) and fill in. NEVER commit .env.
# Used by the quarantine notifier (python -m claims_etl.notifications.cli).

# Fine-grained personal access token, scoped to ONLY this repository, with
# Repository permissions: Issues = Read and write (Metadata = Read is automatic).
GITHUB_TOKEN=

# owner/name of the repository that receives quarantine issues.
GITHUB_REPO=fredr171/claims-lakehouse-dbt-duckdb
